# Conexão com o PostgreSQL.
# Para desenvolvimento, rode `npm run db:dev` e copie a URL "TCP" que ele mostra.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/verissimo?schema=public"

# Troque por um texto longo e aleatório em produção.
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="8h"

PORT=3333
# Endereço do frontend (liberado no CORS)
WEB_URL="http://localhost:3000"

# Banco auxiliar usado pelo `prisma migrate dev` para comparar o schema.
# Com `npm run db:dev`, use a URL do servidor "shadow" (porta seguinte à do banco).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# E-mail (SMTP). Sem isso, os e-mails ficam em .emails/ e o link aparece no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Verissimo ERP <nao-responda@seudominio.com.br>"
# Endereço público do site (usado nos links dos e-mails). No Render é detectado sozinho.
APP_URL="http://localhost:3000"

# Fiscal: chave que criptografa certificado e CSC no banco (não troque depois de enviar o certificado).
FISCAL_CHAVE="troque-por-um-texto-longo-e-aleatorio"
# Responsável técnico pela emissão (sua software house), exigido por alguns estados.
RESP_TEC_CNPJ=
RESP_TEC_CONTATO=
RESP_TEC_EMAIL=
RESP_TEC_FONE=
# Só use false se a conexão com a SEFAZ falhar por causa do certificado do servidor dela.
SEFAZ_VERIFICAR_TLS=true
