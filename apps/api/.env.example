# Copie para .env (não versionado) e preencha.

# Ambiente: dev | test | hml | prd. Em hml/prd a API confere DB_HOSTS_PERMITIDOS e segredos fortes.
APP_ENV=dev

# Neon (ADR-006). DATABASE_URL: conexão com pooler (host com "-pooler"), usada pela aplicação.
# DIRECT_URL: conexão direta (sem "-pooler"), usada pelas migrations.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=verify-full"
# Hosts de banco aceitos neste ambiente (obrigatório em hml/prd). Ex.: ep-xxxx-pooler.REGIAO.aws.neon.tech
DB_HOSTS_PERMITIDOS=
# Banco dos testes de integração (npm test). Nunca aponte para HML ou PRD.
DATABASE_URL_TESTE=

# Texto longo e aleatório (>= 32 caracteres em hml/prd): openssl rand -hex 32
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="8h"

PORT=3333
# Origens liberadas no CORS (separadas por vírgula): painel local e catálogo do Firebase.
WEB_URL="http://localhost:3000"
# Endereço público do painel (usado nos links dos e-mails). No Render é detectado sozinho.
APP_URL="http://localhost:3000"

# WhatsApp que recebe os orçamentos do catálogo (55 + DDD + número, só dígitos).
LOJA_WHATSAPP=

# Primeiro administrador da Estância Maciel, criado pelo seed se ainda não existir.
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=
# Empresa de demonstração do Verissimo (admin@demo.com / demo123). Só DEV; proibido em PRD.
SEED_DEMO=false

# Módulos herdados, desligados por padrão (ADR-004): pdv, crm, fiscal.
MODULOS_OPCIONAIS=
# Cadastro público de empresas (SaaS). Só para os testes e2e herdados.
REGISTRO_PUBLICO=false

# E-mail (SMTP). Sem isso, os e-mails ficam em .emails/ e o link aparece no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Estância Maciel <nao-responda@seudominio.com.br>"

# Fiscal (só com MODULOS_OPCIONAIS contendo fiscal): chave que criptografa certificado e CSC.
FISCAL_CHAVE=
RESP_TEC_CNPJ=
RESP_TEC_CONTATO=
RESP_TEC_EMAIL=
RESP_TEC_FONE=
SEFAZ_VERIFICAR_TLS=true
