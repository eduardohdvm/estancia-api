// Verissimo ERP - modelo de dados
// Toda tabela de negócio tem `empresaId`: é assim que cada cliente do SaaS
// enxerga apenas os próprios dados.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Núcleo SaaS ─────────────────────────────

enum Plano {
  BASICO
  PROFISSIONAL
  EMPRESARIAL
}

enum Perfil {
  ADMIN
  GERENTE
  VENDEDOR
  FINANCEIRO
  ESTOQUISTA
  CAIXA // operador de frente de caixa (só PDV)
}

model Empresa {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String?  @unique
  email     String?
  telefone  String?
  plano     Plano    @default(BASICO)
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios              Usuario[]
  pessoas               Pessoa[]
  categorias            Categoria[]
  produtos              Produto[]
  depositos             Deposito[]
  estoques              Estoque[]
  movimentos            MovimentoEstoque[]
  pedidos               PedidoVenda[]
  contasBancarias       ContaBancaria[]
  categoriasFinanceiras CategoriaFinanceira[]
  lancamentos           Lancamento[]
  caixas                Caixa[]
  pedidosCompra         PedidoCompra[]
  oportunidades         Oportunidade[]
  atividades            Atividade[]
  configuracaoFiscal    ConfiguracaoFiscal?
  notasFiscais          NotaFiscal[]
  sequencias            Sequencia[]
}

model Usuario {
  id        String   @id @default(uuid())
  empresaId String
  nome      String
  email     String   @unique
  senhaHash String
  perfil    Perfil   @default(VENDEDOR)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa       Empresa            @relation(fields: [empresaId], references: [id])
  pedidos       PedidoVenda[]
  caixas        Caixa[]
  oportunidades Oportunidade[]
  atividades    Atividade[]
  recuperacoes  RecuperacaoSenha[]

  @@index([empresaId])
}

// Link de "esqueci minha senha". Só o hash do token fica no banco.
model RecuperacaoSenha {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// Numeração por empresa sem corrida: UPDATE ... SET valor = valor + 1 RETURNING valor (ADR-018).
model Sequencia {
  empresaId String
  nome      String // PEDIDO, COMPRA, CAIXA
  valor     Int    @default(0)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@id([empresaId, nome])
}

// ───────────────────────────── Cadastros ─────────────────────────────

enum TipoPessoa {
  FISICA
  JURIDICA
}

// Cliente e fornecedor ficam na mesma tabela: a mesma pessoa pode ser os dois.
model Pessoa {
  id                String     @id @default(uuid())
  empresaId         String
  tipo              TipoPessoa @default(FISICA)
  nome              String
  nomeFantasia      String?
  documento         String? // CPF ou CNPJ
  email             String?
  telefone          String?
  cep               String?
  endereco          String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  codigoMunicipio   String? // código IBGE (7 dígitos), exigido na NF-e
  uf                String?
  inscricaoEstadual String? // vazio = não contribuinte; "ISENTO" = contribuinte isento
  observacoes       String?
  cliente           Boolean    @default(true)
  fornecedor        Boolean    @default(false)
  ativo             Boolean    @default(true)
  telefoneE164      String? // telefone normalizado (+5511999998888): WhatsApp e cliente do catálogo
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  pedidos       PedidoVenda[]
  pedidosCompra PedidoCompra[]
  lancamentos   Lancamento[]
  oportunidades Oportunidade[]
  atividades    Atividade[]

  @@unique([empresaId, documento])
  @@index([empresaId, telefoneE164])
  @@index([empresaId, nome])
}

model Categoria {
  id        String   @id @default(uuid())
  empresaId String
  nome      String
  createdAt DateTime @default(now())

  empresa  Empresa   @relation(fields: [empresaId], references: [id])
  produtos Produto[]

  @@unique([empresaId, nome])
}

model Produto {
  id            String   @id @default(uuid())
  empresaId     String
  categoriaId   String?
  codigo        String
  codigoBarras  String?
  nome          String
  descricao     String?
  unidade       String   @default("UN")
  precoCusto    Decimal  @default(0) @db.Decimal(14, 2)
  precoVenda    Decimal  @default(0) @db.Decimal(14, 2)
  estoqueMinimo Decimal  @default(0) @db.Decimal(14, 3)
  servico       Boolean  @default(false) // serviço não movimenta estoque
  ativo         Boolean  @default(true)
  // Catálogo público (estancia-catalogo)
  publicado       Boolean       @default(false) // aparece no catálogo
  armazenamento   Armazenamento @default(AMBIENTE)
  vendaFracionada Boolean       @default(false) // aceita quantidade quebrada (ex.: 1,5 kg)
  // Dados fiscais (NF-e/NFC-e). Sem CFOP/CSOSN, valem os padrões da configuração fiscal.
  ncm           String?
  cest          String?
  cfop          String?
  csosn         String?
  origem        Int      @default(0) // 0 = nacional
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  empresa     Empresa            @relation(fields: [empresaId], references: [id])
  categoria   Categoria?         @relation(fields: [categoriaId], references: [id])
  estoques    Estoque[]
  movimentos  MovimentoEstoque[]
  itens       PedidoVendaItem[]
  itensCompra PedidoCompraItem[]

  @@unique([empresaId, codigo])
  @@index([empresaId, nome])
}

enum Armazenamento {
  AMBIENTE
  REFRIGERADO
  CONGELADO
}

// ───────────────────────────── Estoque ─────────────────────────────

model Deposito {
  id        String   @id @default(uuid())
  empresaId String
  nome      String
  padrao    Boolean  @default(false)
  createdAt DateTime @default(now())

  empresa       Empresa            @relation(fields: [empresaId], references: [id])
  estoques      Estoque[]
  movimentos    MovimentoEstoque[]
  pedidos       PedidoVenda[]
  pedidosCompra PedidoCompra[]

  @@unique([empresaId, nome])
}

// Saldo atual de um produto em um depósito.
model Estoque {
  id         String  @id @default(uuid())
  empresaId  String
  produtoId  String
  depositoId String
  quantidade Decimal @default(0) @db.Decimal(14, 3)

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  produto  Produto  @relation(fields: [produtoId], references: [id])
  deposito Deposito @relation(fields: [depositoId], references: [id])

  @@unique([produtoId, depositoId])
  @@index([empresaId])
}

enum TipoMovimento {
  ENTRADA
  SAIDA
  AJUSTE
}

// Histórico de tudo que entrou e saiu do estoque.
model MovimentoEstoque {
  id             String        @id @default(uuid())
  empresaId      String
  produtoId      String
  depositoId     String
  tipo           TipoMovimento
  quantidade     Decimal       @db.Decimal(14, 3)
  saldoAnterior  Decimal       @db.Decimal(14, 3)
  saldoNovo      Decimal       @db.Decimal(14, 3)
  custoUnitario  Decimal?      @db.Decimal(14, 2)
  observacao     String?
  pedidoId       String?
  pedidoCompraId String?
  usuarioId      String?
  createdAt      DateTime      @default(now())

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  produto      Produto       @relation(fields: [produtoId], references: [id])
  deposito     Deposito      @relation(fields: [depositoId], references: [id])
  pedido       PedidoVenda?  @relation(fields: [pedidoId], references: [id])
  pedidoCompra PedidoCompra? @relation(fields: [pedidoCompraId], references: [id])

  @@index([empresaId, createdAt])
  @@index([produtoId])
}

// ───────────────────────────── Vendas ─────────────────────────────

enum StatusPedido {
  ORCAMENTO
  APROVADO
  FATURADO
  CANCELADO
}

enum OrigemPedido {
  PEDIDO // criado na tela de vendas
  PDV // venda de balcão na frente de caixa
  CATALOGO // orçamento enviado pelo catálogo público
}

enum Modalidade {
  RETIRADA
  ENTREGA
}

model PedidoVenda {
  id          String       @id @default(uuid())
  empresaId   String
  numero      Int
  origem      OrigemPedido @default(PEDIDO)
  caixaId     String?
  clienteId   String
  vendedorId  String?
  depositoId  String
  status      StatusPedido @default(ORCAMENTO)
  subtotal    Decimal      @default(0) @db.Decimal(14, 2)
  desconto    Decimal      @default(0) @db.Decimal(14, 2)
  frete       Decimal      @default(0) @db.Decimal(14, 2)
  total       Decimal      @default(0) @db.Decimal(14, 2)
  parcelas    Int          @default(1)
  observacoes String?
  faturadoEm  DateTime?
  // Orçamento do catálogo público (ADR-009)
  modalidade          Modalidade @default(RETIRADA)
  enderecoEntrega     Json? // cópia do endereço informado pelo cliente
  solicitacaoOriginal Json? // cópia imutável do carrinho e dos preços como o cliente viu
  whatsappAbertoEm    DateTime? // cliente tocou no botão; não prova que a mensagem foi enviada
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  empresa     Empresa            @relation(fields: [empresaId], references: [id])
  caixa       Caixa?             @relation(fields: [caixaId], references: [id])
  cliente     Pessoa             @relation(fields: [clienteId], references: [id])
  vendedor    Usuario?           @relation(fields: [vendedorId], references: [id])
  deposito    Deposito           @relation(fields: [depositoId], references: [id])
  itens       PedidoVendaItem[]
  movimentos  MovimentoEstoque[]
  lancamentos Lancamento[]
  pagamentos  PagamentoVenda[]
  notas       NotaFiscal[]

  @@unique([empresaId, numero])
  @@index([empresaId, status])
  @@index([caixaId])
}

model PedidoVendaItem {
  id            String   @id @default(uuid())
  pedidoId      String
  produtoId     String
  descricao     String
  quantidade    Decimal  @db.Decimal(14, 3)
  precoUnitario Decimal  @db.Decimal(14, 2)
  desconto      Decimal  @default(0) @db.Decimal(14, 2)
  total         Decimal  @db.Decimal(14, 2)
  // Custo do produto no momento do faturamento (para margem e CMV nos relatórios).
  custoUnitario Decimal? @db.Decimal(14, 2)

  pedido  PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto     @relation(fields: [produtoId], references: [id])
}

// ───────────────────────────── PDV (frente de caixa) ─────────────────────────────

enum StatusCaixa {
  ABERTO
  FECHADO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
  CREDIARIO // "fiado": vira conta a receber em aberto
}

enum TipoMovimentoCaixa {
  SUPRIMENTO // dinheiro colocado na gaveta (ex.: troco inicial extra)
  SANGRIA // dinheiro retirado da gaveta (ex.: levado ao cofre)
}

// Uma sessão de caixa: da abertura ao fechamento, por operador.
model Caixa {
  id              String      @id @default(uuid())
  empresaId       String
  usuarioId       String
  contaBancariaId String // conta financeira onde as vendas entram
  numero          Int
  status          StatusCaixa @default(ABERTO)
  valorAbertura   Decimal     @default(0) @db.Decimal(14, 2)
  valorFechamento Decimal?    @db.Decimal(14, 2) // dinheiro contado no fechamento
  valorEsperado   Decimal?    @db.Decimal(14, 2) // dinheiro que deveria haver na gaveta
  abertoEm        DateTime    @default(now())
  fechadoEm       DateTime?
  observacoes     String?

  empresa       Empresa          @relation(fields: [empresaId], references: [id])
  usuario       Usuario          @relation(fields: [usuarioId], references: [id])
  contaBancaria ContaBancaria    @relation(fields: [contaBancariaId], references: [id])
  vendas        PedidoVenda[]
  movimentos    MovimentoCaixa[]
  pagamentos    PagamentoVenda[]

  @@unique([empresaId, numero])
  @@index([empresaId, status])
}

model MovimentoCaixa {
  id        String             @id @default(uuid())
  caixaId   String
  tipo      TipoMovimentoCaixa
  valor     Decimal            @db.Decimal(14, 2)
  motivo    String?
  createdAt DateTime           @default(now())

  caixa Caixa @relation(fields: [caixaId], references: [id], onDelete: Cascade)
}

model PagamentoVenda {
  id       String         @id @default(uuid())
  pedidoId String
  caixaId  String?
  forma    FormaPagamento
  valor    Decimal        @db.Decimal(14, 2) // valor que abate a venda (já sem o troco)
  troco    Decimal        @default(0) @db.Decimal(14, 2)

  pedido PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  caixa  Caixa?      @relation(fields: [caixaId], references: [id])

  @@index([caixaId])
}

// ───────────────────────────── Compras ─────────────────────────────

enum StatusCompra {
  RASCUNHO
  ENVIADO // pedido enviado ao fornecedor, aguardando entrega
  RECEBIDO
  CANCELADO
}

model PedidoCompra {
  id              String       @id @default(uuid())
  empresaId       String
  numero          Int
  fornecedorId    String
  depositoId      String
  status          StatusCompra @default(RASCUNHO)
  subtotal        Decimal      @default(0) @db.Decimal(14, 2)
  desconto        Decimal      @default(0) @db.Decimal(14, 2)
  frete           Decimal      @default(0) @db.Decimal(14, 2)
  total           Decimal      @default(0) @db.Decimal(14, 2)
  parcelas        Int          @default(1)
  previsaoEntrega DateTime?    @db.Date
  observacoes     String?
  recebidoEm      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  empresa     Empresa            @relation(fields: [empresaId], references: [id])
  fornecedor  Pessoa             @relation(fields: [fornecedorId], references: [id])
  deposito    Deposito           @relation(fields: [depositoId], references: [id])
  itens       PedidoCompraItem[]
  movimentos  MovimentoEstoque[]
  lancamentos Lancamento[]

  @@unique([empresaId, numero])
  @@index([empresaId, status])
}

model PedidoCompraItem {
  id            String  @id @default(uuid())
  pedidoId      String
  produtoId     String
  descricao     String
  quantidade    Decimal @db.Decimal(14, 3)
  custoUnitario Decimal @db.Decimal(14, 2)
  total         Decimal @db.Decimal(14, 2)

  pedido  PedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto      @relation(fields: [produtoId], references: [id])
}

// ───────────────────────────── CRM ─────────────────────────────

enum EtapaOportunidade {
  PROSPECCAO
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

// Um negócio em andamento no funil de vendas.
model Oportunidade {
  id                 String            @id @default(uuid())
  empresaId          String
  titulo             String
  pessoaId           String?
  contatoNome        String? // para quem ainda não é cliente cadastrado
  contatoTelefone    String?
  contatoEmail       String?
  valorEstimado      Decimal           @default(0) @db.Decimal(14, 2)
  etapa              EtapaOportunidade @default(PROSPECCAO)
  responsavelId      String?
  previsaoFechamento DateTime?         @db.Date
  origem             String? // ex.: indicação, Instagram, site
  motivoPerda        String?
  observacoes        String?
  fechadaEm          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  pessoa      Pessoa?     @relation(fields: [pessoaId], references: [id])
  responsavel Usuario?    @relation(fields: [responsavelId], references: [id])
  atividades  Atividade[]

  @@index([empresaId, etapa])
}

enum TipoAtividade {
  LIGACAO
  WHATSAPP
  EMAIL
  REUNIAO
  VISITA
  TAREFA
  NOTA
}

// Interações e tarefas ligadas a um cliente e/ou oportunidade.
model Atividade {
  id             String        @id @default(uuid())
  empresaId      String
  tipo           TipoAtividade
  descricao      String
  oportunidadeId String?
  pessoaId       String?
  usuarioId      String
  agendadaPara   DateTime?
  concluida      Boolean       @default(false)
  concluidaEm    DateTime?
  createdAt      DateTime      @default(now())

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  pessoa       Pessoa?       @relation(fields: [pessoaId], references: [id])
  usuario      Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, usuarioId, concluida])
  @@index([oportunidadeId])
}

// ───────────────────────────── Financeiro ─────────────────────────────

enum TipoLancamento {
  PAGAR
  RECEBER
}

enum StatusLancamento {
  ABERTO
  PAGO
  CANCELADO
}

model ContaBancaria {
  id           String   @id @default(uuid())
  empresaId    String
  nome         String // ex.: "Caixa", "Banco do Brasil"
  banco        String?
  agencia      String?
  conta        String?
  saldoInicial Decimal  @default(0) @db.Decimal(14, 2)
  ativa        Boolean  @default(true)
  createdAt    DateTime @default(now())

  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  lancamentos Lancamento[]
  caixas      Caixa[]

  @@unique([empresaId, nome])
}

// Plano de contas simplificado (ex.: "Vendas", "Aluguel", "Salários").
model CategoriaFinanceira {
  id        String         @id @default(uuid())
  empresaId String
  nome      String
  tipo      TipoLancamento
  createdAt DateTime       @default(now())

  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  lancamentos Lancamento[]

  @@unique([empresaId, nome, tipo])
}

// Contas a pagar e a receber.
model Lancamento {
  id              String           @id @default(uuid())
  empresaId       String
  tipo            TipoLancamento
  status          StatusLancamento @default(ABERTO)
  descricao       String
  pessoaId        String?
  categoriaId     String?
  contaBancariaId String?
  pedidoId        String?
  pedidoCompraId  String?
  valor           Decimal          @db.Decimal(14, 2)
  valorPago       Decimal?         @db.Decimal(14, 2)
  vencimento      DateTime         @db.Date
  pagoEm          DateTime?        @db.Date
  parcela         Int              @default(1)
  totalParcelas   Int              @default(1)
  observacoes     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  empresa       Empresa              @relation(fields: [empresaId], references: [id])
  pessoa        Pessoa?              @relation(fields: [pessoaId], references: [id])
  categoria     CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])
  contaBancaria ContaBancaria?       @relation(fields: [contaBancariaId], references: [id])
  pedido        PedidoVenda?         @relation(fields: [pedidoId], references: [id])
  pedidoCompra  PedidoCompra?        @relation(fields: [pedidoCompraId], references: [id])

  @@index([empresaId, tipo, status, vencimento])
}

// ───────────────────────────── Fiscal (NF-e / NFC-e) ─────────────────────────────

enum AmbienteFiscal {
  SIMULACAO // gera e assina o XML, mas não envia à SEFAZ (para testes e demonstração)
  HOMOLOGACAO // envia à SEFAZ de teste: sem valor fiscal
  PRODUCAO // notas com valor fiscal
}

model ConfiguracaoFiscal {
  id                    String         @id @default(uuid())
  empresaId             String         @unique
  razaoSocial           String
  nomeFantasia          String?
  cnpj                  String // só dígitos
  inscricaoEstadual     String
  inscricaoMunicipal    String?
  cnae                  String?
  crt                   Int            @default(1) // 1 = Simples Nacional, 2 = Simples (excesso), 3 = Regime normal, 4 = MEI
  logradouro            String
  numero                String
  complemento           String?
  bairro                String
  codigoMunicipio       String // IBGE, 7 dígitos
  municipio             String
  uf                    String
  cep                   String
  telefone              String?
  ambiente              AmbienteFiscal @default(SIMULACAO)
  serieNfe              Int            @default(1)
  proximoNumeroNfe      Int            @default(1)
  serieNfce             Int            @default(1)
  proximoNumeroNfce     Int            @default(1)
  cfopPadrao            String         @default("5102")
  csosnPadrao           String         @default("102")
  informacoesAdicionais String?
  emitirNfceNoPdv       Boolean        @default(false)
  // CSC (código de segurança do contribuinte) da NFC-e, gerado no site da SEFAZ.
  cscId                 String?
  cscToken              String? // criptografado
  // Certificado digital A1 (.pfx) e senha, criptografados.
  certificado           String?
  certificadoSenha      String?
  certificadoTitular    String?
  certificadoValidade   DateTime?
  updatedAt             DateTime       @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
}

enum ModeloNota {
  NFE // modelo 55: venda entre empresas, DANFE em A4
  NFCE // modelo 65: venda ao consumidor no balcão, cupom com QR Code
}

enum StatusNota {
  AUTORIZADA
  REJEITADA
  CANCELADA
  DENEGADA
}

model NotaFiscal {
  id                        String         @id @default(uuid())
  empresaId                 String
  modelo                    ModeloNota
  serie                     Int
  numero                    Int
  chave                     String         @unique
  ambiente                  AmbienteFiscal
  status                    StatusNota
  pedidoId                  String?
  destinatarioNome          String?
  destinatarioDocumento     String?
  valorTotal                Decimal        @db.Decimal(14, 2)
  xml                       String // XML assinado que foi enviado
  xmlAutorizado             String? // nfeProc: XML + protocolo de autorização
  protocolo                 String?
  codigoStatus              Int? // cStat da SEFAZ (100 = autorizada)
  motivo                    String? // xMotivo da SEFAZ
  qrCode                    String? // NFC-e
  urlConsulta               String? // NFC-e
  autorizadaEm              DateTime?
  canceladaEm               DateTime?
  protocoloCancelamento     String?
  justificativaCancelamento String?
  xmlCancelamento           String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  empresa Empresa      @relation(fields: [empresaId], references: [id])
  pedido  PedidoVenda? @relation(fields: [pedidoId], references: [id])

  @@unique([empresaId, modelo, serie, numero])
